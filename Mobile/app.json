{
  "expo": {
    "name": "BusDN",
    "slug": "busdn-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "busdn",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BusDN uses your current location to sync driver GPS during active trips."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BusDN uses your current location to sync driver GPS during active trips."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f2fcf8"
      }
    }
  }
}
