# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/busdn
DATABASE_NAME=busdn

# Auth
JWT_SECRET=change_me
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
SESSION_SECRET=change_me

# Cloudinary
# Preferred: copy API environment variable from the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloudinary_cloud_name

# Or set the fields separately. Use the Cloud name from the Cloudinary dashboard,
# not the app name or upload folder.
# Avatar uploads are stored under the Cloudinary folder: busdn/avatars.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
